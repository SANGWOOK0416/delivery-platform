# Spring Boot does not load this file automatically. Set these values in your IDE,
# shell, or deployment environment before starting the affected service.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WEATHER_KAFKA_GROUP_ID=weather-group
NOTIFICATION_KAFKA_GROUP_ID=notification-group
KAKAO_API_TOKEN=
KAKAO_WEB_URL=https://example.com
KMA_SERVICE_KEY=
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_GRID_NX=60
KMA_GRID_NY=127
# Kakao Local API REST key (address -> lat/lon geocoding in weather-agent).
# This is NOT the same value as KAKAO_API_TOKEN above: that's a per-user OAuth
# access token for the memo-send API, this is the app's own REST API key.
KAKAO_REST_API_KEY=
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
# Postgres (order-service and notification-service each use their own database
# on the same instance: order_db / notification_db — see docker/postgres-init.sql)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
ORDER_DB_NAME=order_db
NOTIFICATION_DB_NAME=notification_db
# CORS: allowed origin for the React dashboard (order-service and notification-service)
FRONTEND_ORIGIN=http://localhost:5173
